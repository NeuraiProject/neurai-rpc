{
  "name": "@neuraiproject/neurai-rpc",
  "version": "0.6.0",
  "description": "Helps you access your Neurai full node using RPC from JavaScript",
  "types": "dist/index.d.ts",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "index.ts",
    "docs.ts",
    "docs.json",
    "neurai_methods.md",
    "DEPIN_EXAMPLES.md",
    "DEPIN_IMPLEMENTATION_GUIDE_EN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "create-docs": "node createDocs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuraiproject/neurai-rpc.git"
  },
  "keywords": [],
  "author": "Dick Henrik Larsson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neuraiproject/neurai-rpc/issues"
  },
  "homepage": "https://github.com/neuraiproject/neurai-rpc#readme",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "jest": "^29.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
